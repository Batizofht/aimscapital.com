					<style>
    #country-map {
        width: 100%;
    }
    #country-map path {
        fill: #9B9B9B;
    }
    #country-map g {
        cursor: pointer;
        pointer-events: bounding-box;
    }
    #country-map g.active path {
        fill: orange;
    }
    html body .elementor-element.country-flag.active .elementor-widget-container {
        border-style: solid;
        border-width: 3px 3px 3px 3px;
        border-color: var(--e-global-color-2ace983);
        box-shadow: 0px 0px 6px 0px rgb(172 172 172 / 25%);
    }
</style>				</div>
