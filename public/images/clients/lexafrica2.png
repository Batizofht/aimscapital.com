				<div class="elementor-element elementor-element-8e13d1c elementor-widget elementor-widget-html" data-id="8e13d1c" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">
				<div class="elementor-widget-container">
					<script type="text/rocketlazyloadscript">window.addEventListener('DOMContentLoaded', function() {
    jQuery(document).on('mouseenter mouseleave', '#country-flags .country-flag', function (event) {
        var id = this.getAttribute('id').toLowerCase().replace(' ', '_').replace('country-flag-', '');
        jQuery('#country-map g.'+id)[event.type === 'mouseenter' ? 'addClass':'removeClass']('active');
    });
    jQuery(document).on('mouseenter mouseleave click', '#country-map g', function (event) {
        var c = this.getAttribute('class');
        if (!c)return;
 
        с = c.replace('active', '').replace(' ', '');
        var id = c.replace('_', ' ').replace(/(^\w{1})|(\s+\w{1})/g, letter => letter.toUpperCase());
        id = id.replace(' Active', '');
        if (id.toLowerCase()==='drc') id = 'DRC';
        var target = jQuery('[id="country-flag-'+id+'"');
        jQuery(this)[event.type === 'mouseenter' ? 'addClass':'removeClass']('active');
        target[event.type === 'mouseenter' ? 'addClass':'removeClass']('active');
        if (event.type==='click'){
            window.location = (target.find('a').eq(0).get(0).href)
        }
    });
});</script>				</div>
				</div>
