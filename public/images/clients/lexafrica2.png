<script type="text/rocketlazyloadscript">window.addEventListener('DOMContentLoaded', function() {
if (jQuery('.jet-listing-grid--15929 .jet-listing-grid__item').length > 1) {
  jQuery('.lex-firms-listing-grid').each(function() {
    // Remove all children except the first one
    jQuery(this).children().slice(1).remove();
  });
}
	
	//hide firm detail icon if there are not details
jQuery('.lex-firms-listing-grid .elementor-icon-box-wrapper').each(function() {
  if (jQuery(this).children().length === 1) {
    jQuery(this).hide();
  }
});

	//fix lawyers URL overlap
	jQuery(function($){
  var $secondLi = $('.lex-lawyer-list-details ul.elementor-icon-list-items li').eq(1);
  var url = $secondLi.find('a').attr('href');

  // Replace the span text with a clickable "Website" link
  $secondLi.find('.elementor-icon-list-text').html('<a href="'+url+'" target="_blank">Website</a>');
});
